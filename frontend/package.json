{
  "name": "sentinelai-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check src/csvBatches.ts",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 110
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "jsdom": "27.2.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  }
}
